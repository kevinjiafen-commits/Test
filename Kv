local function bypassErrorHandler()
    print("[ErrorHandler] Start...")
    local count = 0
    if type(xpcall) == "function" then
        local oldXpcall = xpcall
        xpcall = function(f, err)
            return oldXpcall(f, function(e) return end)
        end
        count = count + 1
    end
    local oldError = error
    error = function(msg, level) return end
    count = count + 1
    print("[ErrorHandler] Applied " .. count .. " shields")
    notify("ErrorHandler", "Applied " .. count .. " shields", 3)
end

