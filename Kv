-- ========== 模块 6: 签名与标识清除 ==========
local function bypassSignatures()
    print("[Signature] Start...")
    local signaturesBypassed = 0
    local tablesToClean = { "_G", "shared", "getgenv", "getrenv", "game", "workspace" }
    for _, tblName in ipairs(tablesToClean) do
        local target = getExisting(tblName) or _G[tblName]
        if type(target) == "table" then
            for k, v in pairs(target) do
                if type(k) == "string" then
                    if k:find("signature") or k:find("checksum") or k:find("hash") or
                       k:find("anticheat") or k:find("detect") or k:find("fingerprint") then
                        target[k] = nil
                        signaturesBypassed = signaturesBypassed + 1
                    end
                end
            end
        end
    end
    print("[Signature] Cleared " .. signaturesBypassed .. " signatures")
    notify("Signature", "Cleared " .. signaturesBypassed .. " signatures", 3)
end

