local function notify(title, text, duration)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 5
        })
    end)
end

local function safeCall(func, ...)
    local ok, ret = pcall(func, ...)
    if not ok then
        print("[SafeCall] Error:", ret)
    end
    return ok, ret
end

local function getExisting(name)
    return getgenv()[name] or _G[name] or rawget(getfenv(), name)
end

-- ========== 模块 1: Metamethod 基础劫持 ==========
local function bypassMetaMethods()
    print("[Metamethod] Start...")
    local checks = {
        "checkcaller", "getcallingscript", "getfenv", "setfenv",
        "getreg", "getgc", "getconnections", "hookfunction", "newcclosure",
        "is_synapse", "is_scriptware", "is_krnl", "is_proto", "is_delta"
    }
    local found = {}
    for _, c in ipairs(checks) do
        if getExisting(c) then found[#found+1] = c end
    end
    -- 安全替换 hookfunction
    if type(hookfunction) == "function" then
        local oldHook = hookfunction
        hookfunction = function(f, r)
            return oldHook(f, function(...)
                local args = {...}
                for i, v in ipairs(args) do
                    if type(v) == "table" and (v.__type or v.__index) then
                        args[i] = nil
                    end
                end
                return r(unpack(args))
            end)
        end
    end
    -- 谨慎解锁只读环境（仅当函数存在）
    if setreadonly then
        safeCall(setreadonly, getrenv(), false)
        safeCall(setreadonly, getreg(), false)
        safeCall(setreadonly, getgc(), false)
    end
    print("[Metamethod] Bypassed " .. #found .. " checks")
    notify("Metamethod", "Bypassed " .. #found .. " checks", 3)
end

-- ========== 模块 2: 远程欺骗（仅针对名称匹配的远程） ==========
local function bypassHandshakes()
    print("[Handshake] Start...")
    local remotes = game:GetService("ReplicatedStorage"):GetDescendants()
    local count = 0
    local function fakeResponse()
        return true, {
            status = "valid",
            token = "bypass_" .. math.random(1000,9999),
            timestamp = os.time(),
            checksum = "ok"
        }
    end
    for _, remote in ipairs(remotes) do
        if (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) and type(hookfunction) == "function" then
            local name = remote.Name:lower()
            if name:find("handshake") or name:find("validate") or name:find("verify") or
               name:find("auth") or name:find("challenge") or name:find("ping") then
                count = count + 1
                if remote:IsA("RemoteEvent") then
                    safeCall(hookfunction, remote.FireServer, function(self, ...)
                        return fakeResponse()
                    end)
                elseif remote:IsA("RemoteFunction") then
                    safeCall(hookfunction, remote.InvokeServer, function(self, ...)
                        return fakeResponse()
                    end)
                end
            end
        end
    end
    print("[Handshake] Bypassed " .. count .. " remote checks")
    notify("Handshake", "Bypassed " .. count .. " remotes", 3)
end

-- ========== 模块 3: Hook 检测清除（仅处理已知函数） ==========
local function bypassHookChecks()
    print("[HookCheck] Start...")
    local hooksBypassed = 0
    if type(detour_function) == "function" then
        detour_function = function(...) return true end
        hooksBypassed = hooksBypassed + 1
    end
    if type(hookfunction) == "function" then
        -- 只处理 _G 中的钩子函数
        for k, v in pairs(_G) do
            if type(v) == "function" and string.find(tostring(k), "hook") then
                _G[k] = nil
                hooksBypassed = hooksBypassed + 1
            end
        end
    end
    if type(getconnections) == "function" then
        local events = {
            game:GetService("ScriptContext").Error,
            game:GetService("LogService").MessageOut,
        }
        for _, ev in ipairs(events) do
            local cons = getconnections(ev)
            if cons then
                for _, c in ipairs(cons) do
                    safeCall(c.Disable, c)
                    hooksBypassed = hooksBypassed + 1
                end
            end
        end
    end
    print("[HookCheck] Bypassed " .. hooksBypassed .. " hooks")
    notify("HookCheck", "Bypassed " .. hooksBypassed .. " hooks", 3)
end

-- ========== 模块 4: 关键函数恢复 ==========
local function bypassDetours()
    print("[Detour] Start...")
    local detoursBypassed = 0
    local critical = {
        "Instance.new", "getfenv", "setfenv", "getreg", "getgc", "checkcaller",
        "getrenv", "loadstring", "require", "print", "warn", "error",
        "pcall", "xpcall", "wait", "tick", "time"
    }
    for _, funcName in ipairs(critical) do
        safeCall(function()
            local original = getExisting(funcName)
            if original then
                _G[funcName] = original
                detoursBypassed = detoursBypassed + 1
            end
        end)
    end
    print("[Detour] Restored " .. detoursBypassed .. " functions")
    notify("Detour", "Restored " .. detoursBypassed .. " functions", 3)
end

