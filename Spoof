-- ============================================================
-- SAFE FULL-GAME-LOAD STARTUP EXECUTOR
-- ============================================================
task.spawn(function()
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end

    repeat task.wait(0.5) until LocalPlayer and LocalPlayer:FindFirstChild("PlayerScripts")

    local controllers = LocalPlayer.PlayerScripts:WaitForChild("Controllers", 15)
    if controllers then
        local playerDataController = controllers:WaitForChild("PlayerDataController", 15)
        if playerDataController then
            local success, DataController = pcall(require, playerDataController)
            if success and DataController then
                local timeout = 0
                while not DataController.CurrentData and timeout < 30 do
                    task.wait(0.5)
                    timeout = timeout + 1
                end
            end
        end
    end

    repeat task.wait(0.5) until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer:FindFirstChild("PlayerGui")

    task.wait(1.5)

    pcall(function()
        SaveManager:LoadAutoloadConfig()
    end)

    task.wait(0.3)

    UpdateConfig()
    ApplySpoofs()

    if Controls.unlockWeaponsToggle and Controls.unlockWeaponsToggle.Value then
        task.defer(ExecuteUnlockWeapons)
    end

    if Controls.unlockSkinsToggle and Controls.unlockSkinsToggle.Value then
        task.defer(ExecuteUnlockSkins)
    end
end)

-- Safe Character Respawn listener (Preserves existing RenderStepped connection)
LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart", 10)
    task.wait(1.0)
    UpdateConfig()
    if not getgenv()._spoofConnection then
        ApplySpoofs()
    end
end)

Library:OnUnload(function()
    if getgenv()._spoofConnection then
        pcall(function() getgenv()._spoofConnection:Disconnect() end)
        getgenv()._spoofConnection = nil
    end
    print("Spoofer Hub unloaded")
end)
