local autoPulseVoidEnabled = false
local autoPulseVoidInterval = 1
local autoPulseVoidThread = nil

local function startAutoPulseVoid()
    if autoPulseVoidThread then return end
    autoPulseVoidThread = task.spawn(function()
        while autoPulseVoidEnabled do
            local currentState = Void.settings.enable_void
            if currentState then
                stopVoid()
                Void.settings.enable_void = false
            else
                startVoid()
                Void.settings.enable_void = true
            end
            task.wait(autoPulseVoidInterval)
        end
    end)
end

local function stopAutoPulseVoid()
    autoPulseVoidEnabled = false
    if autoPulseVoidThread then task.cancel(autoPulseVoidThread); autoPulseVoidThread = nil end
end

gbVoidPulse:CreateToggle({ Name = "Enable Auto Pulse", CurrentValue = false, Callback = function(v) autoPulseVoidEnabled = v; if v then startAutoPulseVoid() else stopAutoPulseVoid() end end }, "Toggle_AutoPulseVoid")
