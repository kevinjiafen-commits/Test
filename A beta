local function createESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            if espBoxTracersEnabled and not p.Character:FindFirstChild("ArchESP") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ArchESP"
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Parent = p.Character
            elseif not espBoxTracersEnabled and p.Character:FindFirstChild("ArchESP") then
                p.Character.ArchESP:Destroy()
            end
        end
    end
    if waypointEspEnabled then
        for i, pos in ipairs(teleportLoopPositions) do
            if not Workspace:FindFirstChild("WP_Node_"..i) then
                local node = Instance.new("Part", Workspace)
                node.Name = "WP_Node_"..i
                node.Size = Vector3.new(3,3,3)
                node.Position = pos
                node.Anchored = true
                node.CanCollide = false
                node.Material = Enum.Material.Neon
                node.Color = Color3.fromRGB(0, 255, 255)
            end
        end
    else
        for i = 1, 5 do
            local node = Workspace:FindFirstChild("WP_Node_"..i)
            if node then node:Destroy() end
        end
    end
end

task.spawn(function()
    while true do task.wait(1); pcall(createESP) end
end)

