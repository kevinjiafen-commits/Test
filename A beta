UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.T then running = not running end
    if input.KeyCode == Enum.KeyCode.R then riotRunning = not riotRunning end
    if input.KeyCode == Enum.KeyCode.E then evasionEnabled = not evasionEnabled end
    if input.KeyCode == Enum.KeyCode.B then blinkEnabled = not blinkEnabled end
    if input.KeyCode == Enum.KeyCode.G then ghostEnabled = not ghostEnabled end
    if input.KeyCode == Void.settings.void_keybind then
        if Void.keybindPressed then return end
        Void.keybindPressed = true
        local newState = not Void.settings.enable_void
        if newState then startVoid() else stopVoid() end
        Void.settings.enable_void = newState
        -- Update UI toggle if possible; we'll need a reference to the toggle
        task.delay(0.2, function() Void.keybindPressed = false end)
    end
end)

