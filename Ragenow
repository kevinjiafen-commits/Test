-- Triggerbot 模块
local Triggerbot = {}
Triggerbot.__index = Triggerbot

local HITBOX_NAMES = { "HitboxBody", "HitboxHead", "HitboxHands" }

function Triggerbot.new(clientFighter, clientItem, input)
    local self = setmetatable({}, Triggerbot)
    self.clientFighter = clientFighter
    self.clientItem = clientItem
    self.input = input

    self.rayParams = RaycastParams.new()
    self.rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local function buildFilter()
        local filter = {}
        local characters = workspace:FindFirstChild("characters")
        if characters then
            table.insert(filter, characters)
        end
        local localChar = LocalPlayer.Character
        if localChar then
            table.insert(filter, localChar)
        end
        self.rayParams.FilterDescendantsInstances = filter
    end

    local function isScopedWeapon(item)
        if not item then return false end
        local weaponName = item.Name
        local scoped = Options.triggerbot_scoped.Value or {}
        for weapon, enabled in pairs(scoped) do
            if enabled and weaponName == weapon then
                return true
            end
        end
        return false
    end

    local function rayToTarget()
        local cam = workspace.CurrentCamera
        if not cam then return nil end

        buildFilter()

        local origin = cam.CFrame.Position
        local direction = cam.CFrame.LookVector
        local maxDistance = Options.triggerbot_max_distance.Value

        local result = workspace:Raycast(origin, direction * maxDistance, self.rayParams)
        if not result then return nil end

        local instance = result.Instance
        if not instance then return nil end

        local blacklist = Options.triggerbot_part_blacklist.Value or {}
        if blacklist[instance.Name] then
            return nil
        end

        local character = instance:FindFirstAncestorOfClass("Model")
        if not character then return nil end

        local hum = character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then return nil end

        local ally = character:FindFirstChild("_is_ally")
        if ally and ally.Value then return nil end

        for _, name in ipairs(HITBOX_NAMES) do
            if instance.Name == name then
                return instance
            end
        end
        return nil
    end

    local function tryShoot()
        if not Toggles.triggerbot_enabled.Value then return end
        if not self:keyHeld() then return end

        local target = rayToTarget()
        if not target then return end

        local reaction = Options.triggerbot_reaction_time.Value
        local offset = Options.triggerbot_reaction_time_offset.Value
        local delay = Options.triggerbot_shoot_delay.Value

        task.delay((reaction + offset) / 1000, function()
            task.wait(delay / 1000)
            if not Toggles.triggerbot_enabled.Value then return end
            if self.clientItem then
                pcall(function()
                    self.clientItem:Input(nil)
                end)
            elseif self.input then
                pcall(function()
                    self.input(nil)
                end)
            end
        end)
    end

    function self:keyHeld()
        local mode = Toggles.triggerbot_keybind.Mode
        local key = Toggles.triggerbot_keybind.Value
        if mode == "Always" then
            return true
        end
        if mode == "Hold" then
            return UserInputService:IsKeyDown(key)
        end
        if mode == "Toggle" then
            return Toggles.triggerbot_keybind.KeyDown
        end
        return true
    end

    local function onHeartbeat()
        tryShoot()
    end

    RunService.Heartbeat:Connect(onHeartbeat)
    RunService.RenderStepped:Connect(function()
        if LocalPlayer.Character then
            buildFilter()
        end
    end)

    return self
end

-- Aimbot 模块
local Aimbot = {}
Aimbot.__index = Aimbot

local function makeCircle()
    local circle = Drawing.new("Circle")
    circle.Thickness = 1
    circle.Transparency = 1
    circle.Color = Color3.fromRGB(255, 255, 255)
    circle.Filled = false
    circle.Visible = false
    return circle
end

function Aimbot.new(targeting)
    local self = setmetatable({}, Aimbot)
    self.targeting = targeting or {}
    self.target = nil
    self.manipulated = false

    self.fovCircle = makeCircle()
    self.fovFill = makeCircle()

    local function isAlly(character)
        local flag = character and character:FindFirstChild("_is_ally")
        return flag ~= nil and flag.Value == true
    end

    local function getTargetPart(character)
        local closestPart = Toggles.aimbot_closest_part.Value
        if closestPart then
            local best, bestDist = nil, math.huge
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    local cam = workspace.CurrentCamera
                    local dist = (part.Position - cam.CFrame.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = part
                    end
                end
            end
            return best
        end
        return character:FindFirstChild(Options.targeting_part.Value or "Head")
            or character:FindFirstChild("HitboxHead")
            or character:FindFirstChild("Head")
            or character:FindFirstChild("HumanoidRootPart")
    end

    local function acquire()
        local cam = workspace.CurrentCamera
        if not cam then return nil end

        local radius = Options.aimbot_radius.Value
        local origin = cam.CFrame.Position
        local best, bestScore = nil, math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local character = player.Character
            if not character then continue end
            local hum = character:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            if isAlly(character) then continue end

            local part = getTargetPart(character)
            if not part then continue end

            local screen, onScreen = cam:WorldToViewportPoint(part.Position)
            if not onScreen then continue end

            local distance = (part.Position - origin).Magnitude
            if distance > radius then continue end

            local viewport = cam.ViewportSize
            local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
            local screenVec = Vector2.new(screen.X, screen.Y)
            local score = (screenVec - center).Magnitude
            if score < bestScore then
                bestScore = score
                best = part
            end
        end
        self.target = best
        return best
    end

    local function updateFov()
        local cam = workspace.CurrentCamera
        local viewport = cam.ViewportSize
        local radius = Options.aimbot_radius.Value
        local lerp = Options.aimbot_fov_lerp.Value

        local focal = (viewport.X / 2) / math.tan(math.rad(cam.FieldOfView) / 2)
        local pixelRadius = focal * math.tan(math.rad(radius))

        local circle = self.fovCircle
        circle.Radius = circle.Radius + (pixelRadius - circle.Radius) * lerp
        circle.Position = cam:WorldToViewportPoint(cam.CFrame.Position)

        local fill = self.fovFill
        fill.Radius = circle.Radius
        fill.Position = circle.Position

        local rotationSpeed = Options.aimbot_fov_rotation_speed.Value
        local rotation = Options.aimbot_fov_rotation.Value
        if Toggles.aimbot_fov_moving.Value then
            rotation = rotation + rotationSpeed * tick()
        end
        circle.Color = Options.aimbot_color1.Value
        fill.Color = Options.aimbot_fill_color1.Value
        circle.Transparency = Options.aimbot_outline_color1.Value and 1 or 1
        fill.Transparency = Options.aimbot_fill_color1.Value and 1 or 1
    end

    local function onRender()
        local toggle = Toggles.aimbot_toggle.Value
        local showFov = Toggles.aimbot_showfov.Value

        if not toggle then
            self.fovCircle.Visible = false
            self.fovFill.Visible = false
            return
        end

        updateFov()

        local fovSettings = Options.aimbot_fov_settings.Value or {}
        self.fovCircle.Visible = showFov and fovSettings["position on target"]
        self.fovFill.Visible = showFov and Toggles.aimbot_fov_fill.Value
        if self.fovFill.Visible then
            self.fovFill.Filled = true
        end

        local target = acquire()
        if not target then return end

        local cam = workspace.CurrentCamera
        local look = cam.CFrame.LookVector
        local toTarget = (target.Position - cam.CFrame.Position).Unit
        local dot = look:Dot(toTarget)
        if dot < math.cos(math.rad(Options.aimbot_radius.Value)) then
            return
        end

        local matchAxis = Options.aimbot_match_axis.Value
        local smoothing = Options.aimbot_smoothing.Value

        local desired = CFrame.lookAt(cam.CFrame.Position, target.Position)

        if matchAxis == "y" then
            local yaw = math.atan2(
                target.Position.X - cam.CFrame.Position.X,
                target.Position.Z - cam.CFrame.Position.Z
            )
            local pitch = math.asin(math.clamp(
                (target.Position.Y - cam.CFrame.Position.Y)
                    / (target.Position - cam.CFrame.Position).Magnitude, -1, 1
            ))
            local currentYaw = math.atan2(cam.CFrame.LookVector.X, cam.CFrame.LookVector.Z)
            local delta = (yaw - currentYaw + math.pi) % (2 * math.pi) - math.pi
            cam.CFrame = CFrame.new(cam.CFrame.Position)
                * CFrame.Angles(0, delta * smoothing, 0)
                * CFrame.Angles(-pitch * smoothing, 0, 0)
        else
            cam.CFrame = cam.CFrame:Lerp(desired, smoothing)
        end
    end

    function self:getTarget()
        if not Toggles.aimbot_toggle.Value then return nil end
        if not self:keyHeld() then return nil end
        return acquire()
    end

    function self:keyHeld()
        local mode = Toggles.aimbot_keybind.Mode
        local key = Toggles.aimbot_keybind.Value
        if mode == "Always" then
            return true
        end
        if mode == "Hold" then
            return UserInputService:IsKeyDown(key)
        end
        return true
    end

    function self:destroy()
        pcall(function()
            self.fovCircle:Remove()
        end)
        pcall(function()
            self.fovFill:Remove()
        end)
    end

    RunService.RenderStepped:Connect(onRender)

    return self
end

-- Movement 模块
local Movement = {}
Movement.__index = Movement

function Movement.new(characters)
    local self = setmetatable({}, Movement)
    self.characters = characters

    self.humanoid = nil
    self.humanoidRootPart = nil
    self.currentVehicle = nil

    local function getHumanoid()
        return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    end

    local function getRootPart()
        return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    end

    local function flyLoop()
        if not Toggles.movement_fly.Value then return end
        if self.currentVehicle then return end

        local hum = getHumanoid()
        if not hum then return end
        local root = getRootPart()
        if not root then return end

        hum.PlatformStand = true

        local cam = workspace.CurrentCamera
        local cf = root.CFrame

        local move = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.yAxis end

        local speed = Options.movement_flyvalue.Value
        if move.Magnitude > 0 then
            move = move.Unit * speed
        end

        root.AssemblyLinearVelocity = cf:VectorToWorldSpace(move)
        root.AssemblyAngularVelocity = Vector3.zero
    end

    local function noclipLoop()
        if not Toggles.movement_noclip.Value then return end
        local character = LocalPlayer.Character
        if not character then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                part.CanTouch = false
            end
        end
    end

    local function velocityLoop()
        if not Toggles.movement_velocity.Value then return end
        local root = getRootPart()
        if not root then return end
        local cam = workspace.CurrentCamera
        local speed = Options.movement_velocityvalue.Value
        root.AssemblyLinearVelocity = cam.CFrame.LookVector * speed
    end

    local function slideBoostLoop()
        if not Toggles.movement_slideboost.Value then return end
        local hum = getHumanoid()
        if not hum then return end
        if hum:GetState() == Enum.HumanoidStateType.Sliding then
            local root = getRootPart()
            if root then
                local boost = Options.movement_slideboostvalue.Value
                root.AssemblyLinearVelocity = root.AssemblyLinearVelocity * boost
            end
        end
    end

    local lastJump = 0
    local jumpsUsed = 0

    local function doubleJumpLoop()
        local hum = getHumanoid()
        if not hum then return end
        local root = getRootPart()
        if not root then return end

        local grounded = hum:GetState() == Enum.HumanoidStateType.Running
            or hum:GetState() == Enum.HumanoidStateType.Idle
            or hum:GetState() == Enum.HumanoidStateType.Freefall

        local jumpPressed = UserInputService:IsKeyDown(Enum.KeyCode.Space)

        if grounded then
            jumpsUsed = 0
            return
        end

        local infinite = Toggles.movement_infinite_double_jump.Value
        local limit = 1

        if jumpPressed and jumpsUsed < limit then
            local now = tick()
            if now - lastJump > 0.15 then
                lastJump = now
                jumpsUsed = jumpsUsed + 1
                local height = Options.movement_double_jump_height_multiplier.Value or 1
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    hum.JumpPower * height,
                    root.AssemblyLinearVelocity.Z
                )
                if infinite then
                    jumpsUsed = 0
                end
            end
        end
    end

    local function cleanup()
        self.humanoid = nil
        self.humanoidRootPart = nil
        self.currentVehicle = nil
    end

    RunService.Heartbeat:Connect(flyLoop)
    RunService.Heartbeat:Connect(velocityLoop)
    RunService.Heartbeat:Connect(slideBoostLoop)
    RunService.Stepped:Connect(noclipLoop)
    RunService.Heartbeat:Connect(doubleJumpLoop)

    if self.characters and self.characters.CharacterRemoving then
        self.characters.CharacterRemoving:Connect(cleanup)
    end

    return self
end

function Movement.setCharacter(self, character)
    self.character = character
    self.humanoid = character:WaitForChild("Humanoid")
    self.humanoidRootPart = character:WaitForChild("HumanoidRootPart")
end

-- SilentAim 模块
local SilentAim = {}
SilentAim.__index = SilentAim

local function makeCircle()
    local circle = Drawing.new("Circle")
    circle.Thickness = 1
    circle.Transparency = 1
    circle.Color = Color3.fromRGB(255, 255, 255)
    circle.Filled = false
    circle.Visible = false
    return circle
end

local function makeLine()
    local line = Drawing.new("Line")
    line.Thickness = 1
    line.Transparency = 1
    line.Color = Color3.fromRGB(255, 255, 255)
    line.Visible = false
    return line
end

function SilentAim.new(events)
    local self = setmetatable({}, SilentAim)
    self.events = events or {}
    self.drawings = {}

    self.fovCircle = makeCircle()
    self.fovFill = makeCircle()
    self.targetLine = makeLine()
    table.insert(self.drawings, self.fovCircle)
    table.insert(self.drawings, self.fovFill)
    table.insert(self.drawings, self.targetLine)

    self.target = nil
    self.manipulated = false

    local function updateFovCircle()
        local cam = workspace.CurrentCamera
        local radius = Options.silent_radius.Value
        local lerp = Options.silent_fov_lerp.Value

        local viewport = cam.ViewportSize
        local focal = (viewport.X / 2) / math.tan(math.rad(cam.FieldOfView) / 2)
        local pixelRadius = focal * math.tan(math.rad(radius))

        local circle = self.fovCircle
        circle.Radius = circle.Radius + (pixelRadius - circle.Radius) * lerp
        circle.Position = cam:WorldToViewportPoint(cam.CFrame.Position)

        local fill = self.fovFill
        fill.Radius = circle.Radius
        fill.Position = circle.Position

        local rotation = Options.silent_fov_rotation.Value
        local rotationSpeed = Options.silent_fov_rotation_speed.Value
        if Options.silent_fov_rotation.Value ~= 0 then
            rotation = rotation + rotationSpeed * tick()
        end
        circle.Color = Options.silent_color1.Value
        fill.Color = Options.silent_fill_color1.Value
        circle.Transparency = Options.silent_outline_color1.Value and 1 or 1
    end

    local function onRender()
        local toggle = Toggles.silent_toggle.Value
        local showFov = Toggles.silent_showfov.Value
        local visualize = Toggles.silent_visualize.Value

        if not toggle then
            self.fovCircle.Visible = false
            self.fovFill.Visible = false
            self.targetLine.Visible = false
            return
        end

        updateFovCircle()

        local moving = Toggles.silent_fov_moving.Value
        local fovSettings = Options.silent_fov_settings.Value or {}
        local fillVisible = Toggles.silent_fov_fill.Value
        local outlineVisible = Toggles.silent_fov_outline.Value

        self.fovCircle.Visible = showFov and outlineVisible
        self.fovFill.Visible = showFov and fillVisible
        if self.fovFill.Visible then
            self.fovFill.Filled = true
            self.fovFill.Color = Options.silent_fill_color1.Value
            self.fovFill.Transparency = Options.silent_fill_color1.Value and 1 or 1
        end

        local target = self:acquire()
        if target then
            local cam = workspace.CurrentCamera
            local screen, onScreen = cam:WorldToViewportPoint(target.Position)
            if onScreen then
                local center = cam:WorldToViewportPoint(cam.CFrame.Position)
                self.targetLine.From = Vector2.new(center.X, center.Y)
                self.targetLine.To = Vector2.new(screen.X, screen.Y)
                self.targetLine.Visible = visualize
                self.targetLine.Color = Options.silent_color2.Value
            end
        else
            self.targetLine.Visible = false
        end
    end

    local function getTargetPart(character)
        local closestPart = Options.silent_closest_part.Value
        if closestPart then
            local best, bestDist = nil, math.huge
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    local cam = workspace.CurrentCamera
                    local dist = (part.Position - cam.CFrame.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = part
                    end
                end
            end
            return best
        end
        local head = character:FindFirstChild("HitboxHead") or character:FindFirstChild("Head")
        return head or character:FindFirstChild("HumanoidRootPart")
    end

    function self:acquire()
        local cam = workspace.CurrentCamera
        if not cam then return nil end

        local radius = Options.silent_radius.Value
        local origin = cam.CFrame.Position
        local best, bestScore = nil, math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local character = player.Character
            if not character then continue end
            local hum = character:FindFirstChild("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local ally = character:FindFirstChild("_is_ally")
            if ally and ally.Value then continue end

            local part = getTargetPart(character)
            if not part then continue end

            local screen, onScreen = cam:WorldToViewportPoint(part.Position)
            if not onScreen then continue end

            local distance = (part.Position - origin).Magnitude
            if distance > radius then continue end

            local viewport = cam.ViewportSize
            local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
            local screenVec = Vector2.new(screen.X, screen.Y)
            local score = (screenVec - center).Magnitude
            if score < bestScore then
                bestScore = score
                best = part
            end
        end
        self.target = best
        return best
    end

    function self:getTarget()
        if not Toggles.silent_toggle.Value then return nil end
        local target = self:acquire()
        if not target then return nil end

        local hitchance = Options.silent_hitchance.Value
        if math.random(100) > hitchance then
            self.manipulated = false
            return nil
        end

        self.manipulated = true
        return target
    end

    function self:manipulate(position)
        if not Toggles.silent_manipulation.Value then
            return position
        end
        local target = self:getTarget()
        if not target then
            return nil
        end
        return target.Position
    end

    function self:destroy()
        for _, drawing in ipairs(self.drawings) do
            pcall(function()
                drawing:Remove()
            end)
        end
        self.drawings = {}
    end

    RunService.RenderStepped:Connect(onRender)

    return self
end

-- Effects 模块
local Effects = {}
Effects.__index = Effects

local EFFECT_NAMES = { "fortnite damage", "hit marker", "phantom forces" }
local HIT_SOUNDS = { "sparkle", "ding", "thud", "ping" }

local SOUND_IDS = {
    sparkle = "5070376932",
    ding = "5617972474",
    thud = "4539867272",
    ping = "5070394352",
}

function Effects.new()
    local self = setmetatable({}, Effects)
    self.effects = {}
    self.markers = {}

    self.colors = {
        Options.hit_effects_col_1.Value,
        Options.hit_effects_col_2.Value,
        Options.hit_effects_col_3.Value,
    }

    Options.hit_effects_selected:SetValues(EFFECT_NAMES)

    local function cycleColor(index)
        return self.colors[(index % #self.colors) + 1]
    end

    function self:spawnDamageMarker(character, damage, hitPart)
        if Toggles.hit_effects_disable_marker.Value then return end
        if not character then return end

        local color = cycleColor(#self.markers)
        local head = character:FindFirstChild("Head") or hitPart or character

        local gui = Instance.new("BillboardGui")
        gui.Size = UDim2.fromScale(1, 1)
        gui.AlwaysOnTop = true
        gui.ClipsDescendants = false
        gui.LightInfluence = 0
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.Adornee = head
        gui.Parent = character

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = tostring(math.round(damage))
        label.TextColor3 = color
        label.TextSize = 60
        label.Font = Enum.Font.Fortnite
        label.TextStrokeTransparency = 0
        label.Parent = gui

        local tween = TweenService:Create(gui, TweenInfo.new(
            1, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out
        ), { Position = gui.Position + UDim2.fromOffset(0, -40) })
        tween:Play()

        task.delay(1.2, function()
            gui:Destroy()
        end)

        table.insert(self.markers, gui)
    end

    function self:spawnHitEffect(character, hitPart)
        if not Toggles.hit_effects_enabled.Value then return end
        if Toggles.hit_effects_disable_numbers.Value then return end
        if not hitPart then return end

        local clone = hitPart:Clone()
        clone.Parent = character
        clone.CFrame = hitPart.CFrame
        clone.CanCollide = false
        clone.CanQuery = false
        clone.CanTouch = false
        clone.Anchored = true

        local material = Options.hit_effects_material.Value
        if material and material ~= "Default" then
            pcall(function()
                clone.Material = Enum.Material[material]
            end)
        end

        if Toggles.hit_effects_weld.Value then
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = hitPart
            weld.Part1 = clone
            weld.Parent = clone
        end

        for _, child in ipairs(clone:GetChildren()) do
            if child:IsA("Accessory") or child:IsA("Motor6D") then
                child:Destroy()
            end
        end

        table.insert(self.effects, clone)

        local lifetime = 0.5
        local tween = TweenService:Create(clone, TweenInfo.new(
            lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out
        ), { Transparency = 1 })
        tween:Play()

        task.delay(lifetime, function()
            clone:Destroy()
        end)
    end

    function self:playHitSound(volume)
        if not Toggles.hit_sounds_enabled.Value then return end
        if Toggles.hit_sounds_disable.Value then return end
        if not LocalPlayer.Character then return end

        local selected = Options.hit_sounds_selected.Value or "sparkle"
        local soundName = "HitSound_" .. selected
        local sound = LocalPlayer.Character:FindFirstChild(soundName)

        if not sound then
            sound = Instance.new("Sound")
            sound.Name = soundName
            sound.SoundId = "rbxassetid://" .. SOUND_IDS[selected]
            sound.Volume = Options.hit_sounds_volume.Value
            sound.Parent = LocalPlayer.Character
        end

        sound.Volume = Options.hit_sounds_volume.Value
        sound:Play()
    end

    function self:createMuzzleFlash(origin, target, color)
        local attachments = Instance.new("Attachment")
        attachments.WorldPosition = origin
        attachments.Parent = workspace.Terrain

        local attachmentEnd = Instance.new("Attachment")
        attachmentEnd.WorldPosition = target
        attachmentEnd.Parent = workspace.Terrain

        local beam = Instance.new("Beam")
        beam.Attachment0 = attachments
        beam.Attachment1 = attachmentEnd
        beam.Width0 = 1
        beam.Width1 = 1
        beam.Color = ColorSequence.new(color or Color3.new(1, 1, 1))
        beam.LightEmission = 1
        beam.TextureSpeed = 10
        beam.TextureLength = 1
        beam.Parent = workspace.Terrain

        task.delay(0.08, function()
            local tween = TweenService:Create(beam, TweenInfo.new(
                0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out
            ), { Width0 = 0, Width1 = 0 })
            tween.Completed:Connect(function()
                attachments:Destroy()
                attachmentEnd:Destroy()
            end)
            tween:Play()
        end)
    end

    function self:registerHit(targetCharacter, damage, hitPart)
        self:spawnDamageMarker(targetCharacter, damage, hitPart)
        self:spawnHitEffect(targetCharacter, hitPart)
        self:playHitSound()
    end

    Options.hit_effects_col_1.OnChanged:Connect(function(value)
        self.colors[1] = value
    end)
    Options.hit_effects_col_2.OnChanged:Connect(function(value)
        self.colors[2] = value
    end)
    Options.hit_effects_col_3.OnChanged:Connect(function(value)
        self.colors[3] = value
    end)

    return self
end

function Effects:destroy()
    for _, effect in ipairs(self.effects) do
        pcall(function()
            effect:Destroy()
        end)
    end
    for _, marker in ipairs(self.markers) do
        pcall(function()
            marker:Destroy()
        end)
    end
    self.effects = {}
    self.markers = {}
end

