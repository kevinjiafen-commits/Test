-- 辅助函数：创建带OnChanged的Option
local function createOption(default)
    local option = {
        Value = default,
        OnChanged = Instance.new("BindableEvent")
    }
    return option
end

-- 辅助函数：创建Toggle（包含Mode, KeyDown）
local function createToggle(default)
    local toggle = {
        Value = default,
        Mode = "Always",
        KeyDown = false,
        OnChanged = Instance.new("BindableEvent")
    }
    return toggle
end

