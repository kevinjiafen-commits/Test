        Text = name,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Code,
        TextSize = 14
    })
    local keyButton = createInstance("TextButton", {
        Parent = frame,
        BackgroundColor3 = Color3.fromRGB(60, 60, 60),
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 30),
        Position = UDim2.new(0, 130, 0.5, -15),
        Text = tostring(defaultKey),
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Code,
        TextSize = 14
    })
    local modeButton = createInstance("TextButton", {
        Parent = frame,
        BackgroundColor3 = Color3.fromRGB(60, 60, 60),
        BorderSizePixel = 0,
        Size = UDim2.new(0, 80, 0, 30),
        Position = UDim2.new(0, 235, 0.5, -15),
        Text = defaultMode,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Code,
        TextSize = 14
    })
    local state = {
        Value = defaultKey,
        Mode = defaultMode,
        KeyDown = false
    }
    keyButton.MouseButton1Click:Connect(function()
        keyButton.Text = "Press key..."
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                state.Value = input.KeyCode
                keyButton.Text = tostring(input.KeyCode)
                conn:Disconnect()
                if callback then callback(state.Value) end
            end
        end)
    end)
    modeButton.MouseButton1Click:Connect(function()
        local idx = table.find(modeList, state.Mode) or 1
        idx = idx % #modeList + 1
        state.Mode = modeList[idx]
        modeButton.Text = state.Mode
    end)
    tab.content.CanvasSize = UDim2.new(1, 0, 0, math.max(tab.content.CanvasSize.Y.Offset, (#tab.content:GetChildren() + 1) * 42))
    return state
end

