local function buildUI()
    local tabs = {}

    -- Triggerbot Tab
    tabs[1] = Library:CreateTab("Triggerbot")
    local trigTab = tabs[1]
    Library:AddToggle(trigTab, "Enabled", false, function(v) Toggles.triggerbot_enabled.Value = v end)
    Library:AddKeybind(trigTab, "Keybind", Enum.KeyCode.E, {"Always","Hold","Toggle"}, "Hold", function(key) Toggles.triggerbot_keybind.Value = key end)
    Library:AddSlider(trigTab, "Max Distance", 0, 1000, 500, function(v) Options.triggerbot_max_distance.Value = v end)
    Library:AddSlider(trigTab, "Reaction Time", 0, 500, 100, function(v) Options.triggerbot_reaction_time.Value = v end)
    Library:AddSlider(trigTab, "Reaction Offset", -100, 100, 0, function(v) Options.triggerbot_reaction_time_offset.Value = v end)
    Library:AddSlider(trigTab, "Shoot Delay", 0, 500, 0, function(v) Options.triggerbot_shoot_delay.Value = v end)

    -- Aimbot Tab
    tabs[2] = Library:CreateTab("Aimbot")
    local aimTab = tabs[2]
    Library:AddToggle(aimTab, "Enabled", false, function(v) Toggles.aimbot_toggle.Value = v end)
    Library:AddKeybind(aimTab, "Keybind", Enum.KeyCode.Q, {"Always","Hold","Toggle"}, "Hold", function(key) Toggles.aimbot_keybind.Value = key end)
    Library:AddToggle(aimTab, "Show FOV", false, function(v) Toggles.aimbot_showfov.Value = v end)
    Library:AddToggle(aimTab, "FOV Fill", false, function(v) Toggles.aimbot_fov_fill.Value = v end)
