local UI = {}
UI.__index = UI

local function createInstance(className, properties)
    local inst = Instance.new(className)
    for k, v in pairs(properties or {}) do
        inst[k] = v
    end
    return inst
end

function UI.new(title)
    local self = setmetatable({}, UI)
    self.title = title
    self.screenGui = createInstance("ScreenGui", {
        Name = title,
        Parent = game:GetService("CoreGui")
    })
    self.mainFrame = createInstance("Frame", {
        Name = "MainFrame",
        Parent = self.screenGui,
        BackgroundColor3 = Color3.fromRGB(25, 25, 25),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(600, 400),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Active = true,
        Draggable = true
    })
    self.titleBar = createInstance("Frame", {
        Parent = self.mainFrame,
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30)
    })
    self.titleLabel = createInstance("TextLabel", {
        Parent = self.titleBar,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        Text = title,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Code,
        TextSize = 14
    })
    self.tabBar = createInstance("Frame", {
        Parent = self.mainFrame,
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 40),
        Position = UDim2.new(0, 0, 0, 30)
    })
    self.contentFrame = createInstance("Frame", {
        Parent = self.mainFrame,
        BackgroundColor3 = Color3.fromRGB(30, 30, 30),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, -70),
        Position = UDim2.new(0, 0, 0, 70)
    })
    self.tabs = {}
    self.currentTab = nil
    return self
end

function UI:CreateTab(name)
    local tabButton = createInstance("TextButton", {
        Parent = self.tabBar,
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 1, 0),
        Text = name,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Code,
        TextSize = 14,
        AutoButtonColor = true
    })
    local tabContent = createInstance("ScrollingFrame", {
        Parent = self.contentFrame,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        ScrollBarThickness = 2,
        CanvasSize = UDim2.new(1, 0, 0, 0)
    })
    local tab = { button = tabButton, content = tabContent }
    table.insert(self.tabs, tab)
    if #self.tabs == 1 then
        self:SelectTab(tab)
    end
    tabButton.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)
    return tab
end

function UI:SelectTab(tab)
    for _, t in ipairs(self.tabs) do
        t.content.Visible = (t == tab)
        t.button.BackgroundColor3 = (t == tab) and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(35, 35, 35)
    end
    self.currentTab = tab
end

function UI:AddToggle(tab, name, default, callback)
    local frame = createInstance("Frame", {
        Parent = tab.content,
        BackgroundColor3 = Color3.fromRGB(40, 40, 40),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 10, 0, #tab.content:GetChildren() * 42)
    })
    local label = createInstance("TextLabel", {
        Parent = frame,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.fromOffset(5, 0),
        Text = name,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Code,
        TextSize = 14
    })
    local toggleButton = createInstance("TextButton", {
        Parent = frame,
        BackgroundColor3 = default and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(80, 80, 80),
        BorderSizePixel = 0,
        Size = UDim2.new(0, 60, 0, 30),
        Position = UDim2.new(1, -65, 0.5, -15),
        Text = default and "ON" or "OFF",
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Code,
        TextSize = 12
    })
    local state = { value = default }
    local function update()
        toggleButton.BackgroundColor3 = state.value and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(80, 80, 80)
        toggleButton.Text = state.value and "ON" or "OFF"
        if callback then
            callback(state.value)
        end
    end
    toggleButton.MouseButton1Click:Connect(function()
        state.value = not state.value
        update()
    end)
    tab.content.CanvasSize = UDim2.new(1, 0, 0, math.max(tab.content.CanvasSize.Y.Offset, (#tab.content:GetChildren() + 1) * 42))
    return {
        Value = state,
        Set = function(v) state.value = v; update() end
    }
end

function UI:AddSlider(tab, name, min, max, default, callback)
    local frame = createInstance("Frame", {
        Parent = tab.content,
        BackgroundColor3 = Color3.fromRGB(40, 40, 40),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 10, 0, #tab.content:GetChildren() * 42)
    })
    local label = createInstance("TextLabel", {
        Parent = frame,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 120, 1, 0),
        Position = UDim2.fromOffset(5, 0),
        Text = name,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Code,
        TextSize = 14
    })
    local valueLabel = createInstance("TextLabel", {
        Parent = frame,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 100, 1, 0),
        Position = UDim2.new(0, 120, 0, 0),
        Text = tostring(default),
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Code,
        TextSize = 14
    })
    local slider = createInstance("TextButton", {
        Parent = frame,
        BackgroundColor3 = Color3.fromRGB(60, 60, 60),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -240, 0, 30),
        Position = UDim2.new(0, 230, 0.5, -15),
        Text = "",
        AutoButtonColor = false
    })
    local dragging = false
    local function setValueFromX(x)
        local rel = math.clamp((x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * rel
        return val
    end
    local function updateDisplay(val)
        valueLabel.Text = string.format("%.2f", val)
        if callback then callback(val) end
    end
    slider.MouseButton1Down:Connect(function()
        dragging = true
    end)
    slider.MouseButton1Up:Connect(function()
        dragging = false
    end)
    slider.MouseMoved:Connect(function(x, y)
        if dragging then
            local val = setValueFromX(x)
            updateDisplay(val)
            state.value = val
        end
    end)
    local state = { value = default }
    tab.content.CanvasSize = UDim2.new(1, 0, 0, math.max(tab.content.CanvasSize.Y.Offset, (#tab.content:GetChildren() + 1) * 42))
    return {
        Value = state,
        Set = function(v) state.value = v; updateDisplay(v) end
    }
end

function UI:AddDropdown(tab, name, options, default, callback)
    local frame = createInstance("Frame", {
        Parent = tab.content,
        BackgroundColor3 = Color3.fromRGB(40, 40, 40),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 10, 0, #tab.content:GetChildren() * 42)
    })
    local label = createInstance("TextLabel", {
        Parent = frame,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 120, 1, 0),
        Position = UDim2.fromOffset(5, 0),
        Text = name,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Code,
        TextSize = 14
    })
    local dropdown = createInstance("TextButton", {
        Parent = frame,
        BackgroundColor3 = Color3.fromRGB(60, 60, 60),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -140, 0, 30),
        Position = UDim2.new(0, 130, 0.5, -15),
        Text = default or options[1],
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.Code,
        TextSize = 14
    })
    local state = { value = default or options[1] }
    dropdown.MouseButton1Click:Connect(function()
        local idx = table.find(options, state.value) or 1
        idx = idx % #options + 1
        state.value = options[idx]
        dropdown.Text = state.value
        if callback then callback(state.value) end
    end)
    tab.content.CanvasSize = UDim2.new(1, 0, 0, math.max(tab.content.CanvasSize.Y.Offset, (#tab.content:GetChildren() + 1) * 42))
    return {
        Value = state,
        Set = function(v) state.value = v; dropdown.Text = v end,
        SetValues = function(list) options = list end
    }
end

function UI:AddKeybind(tab, name, defaultKey, modeList, defaultMode, callback)
